# ---------------------------------------------------------------------------
# Copiá este archivo a .env (local) y cargá los mismos valores como secrets
# en Cloudflare para producción.
# ---------------------------------------------------------------------------

# Base de datos. Sin estas variables usa el archivo local `local.db`,
# que NO funciona en Cloudflare Workers: en producción son obligatorias.
# Se crean gratis en turso.tech.
TURSO_URL=libsql://<tu-base>.turso.io
TURSO_AUTH_TOKEN=

# Panel de administración (/login). En producción son obligatorias:
# sin ellas el login rechaza cualquier intento.
ADMIN_USER=
ADMIN_PASSWORD=
# Cadena larga y aleatoria para firmar la cookie de sesión.
# Generar con: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
ADMIN_SESSION_SECRET=

# Dominio público del sitio, usado para las imágenes de Open Graph.
VITE_SITE_URL=https://viveroflor.com.ar
